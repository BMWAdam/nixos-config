(defwidget bar []
  (centerbox :orientation "h"
    (workspaces)
    (music_widget :value {music})
    (sidestuff)))

(defwidget sidestuff []
  (box :class "sidestuff" :orientation "h" :space-evenly false :halign "end"
    (metric :label {volume < 1 ? ""  : 
                    volume < 15 ? "" :
                    volume <= 30 ? "" : 
                    volume <= 50 ? "󰕾" : ""}
            :value volume
            :onchange "scripts/setvol {}"
            :class "vol")
    (metric :label " "
            :value {EWW_RAM.used_mem_perc}
            :onchange ""
            :class "ram")
    (metric :label ""
            :value {round((1 - (EWW_DISK["/"].free / EWW_DISK["/"].total)) * 100, 0)}
            :onchange ""
            :class "dsk")
    (metric :label {brightness < 1 ? "󰃞" :
                brightness <= 30 ? "󰃞" :
                brightness <= 60 ? "󰃟" : "󰃠"}
        :value brightness
        :onchange "scripts/setbrightness {}"
        :class "brightness")
    (metric :label {
              battery <= 20 ? "" :
              battery <= 40 ? "" :
              battery <= 60 ? "" :
              battery <= 80 ? "" : ""
          }
          :value battery
          :onchange ""
          :class "battery")
    (keyboard_layout
            :value {layout}
            :onchange "")
    (time_widget :value {time})
    (date_widget :value {day})))

(defwidget workspaces []
  (box :class "workspaces"
       :orientation "h"
       :space-evenly true
       :halign "start"
       :valign "center"
       :vexpand false
       :spacing 5
    (workspace  :value "1" :onclick "hyprctl dispatch workspace 1")
    (workspace  :value "2" :onclick "hyprctl dispatch workspace 2")
    (workspace  :value "3" :onclick "hyprctl dispatch workspace 3")
    (workspace  :value "4" :onclick "hyprctl dispatch workspace 4")
    (workspace  :value "5" :onclick "hyprctl dispatch workspace 5")
    (workspace  :value "6" :onclick "hyprctl dispatch workspace 6")
    (workspace  :value "7" :onclick "hyprctl dispatch workspace 7")
    (workspace  :value "8" :onclick "hyprctl dispatch workspace 8")
    (workspace  :value "9" :onclick "hyprctl dispatch workspace 9")))

(defwidget workspace [value onclick]
  (box :valign "center"
       :halign "center"
       :vexpand false
       :hexpand false
       :width 5
       :height 5
  (button :class {value == activews ? "workspace ws${value} activews" : "workspace ws${value} notactivews"}
          :onclick {onclick}
          :valign "center"
          :halign "center"
          :width 5
          :vexpand false
          "")))

(defwidget music_widget [value]
  (box :class "music"
       :orientation "h"
       :space-evenly false
       :halign "center"
    (button :class "music-text"
        :onclick "eww open-many --toggle music-widget"
      {value == "" ? "" : value})))

(defwidget metric [label value onchange class]
  (box :orientation "h"
       :class "metric ${class}"
       :space-evenly false
    (box :class "label" label)
    (scale :min 0
           :max 101
           :active {onchange != ""}
           :value value
           :onchange onchange)))

(deflisten music :initial ""
  "scripts/music")

(deflisten volume :initial "20"
  "scripts/getvol")

(deflisten activews :initial "1"
  "scripts/getworkspace")

(deflisten brightness :initial "50"
  "scripts/getbrightness")

(defpoll battery :interval "1s"
  "scripts/getbattery")

(deflisten layout :initial "En"
  "scripts/getlayout")

(defpoll time :interval "1s"
  "date '+%H:%M:%S'")

(defpoll day :interval "10s"
  "date '+%d. %m. %Y'")

(defwidget keyboard_layout [value onchange]
  (box :orientation "h"
       :class "keyboard_layout text_container"
       :space-evenly false
    (box :class "label" "󰌌 ")
    (box :active {onchange != ""}
         :class "text"
         {value})))

(defwidget time_widget [value]
  (box :orientation "h"
       :class "time_widget text_container"
       :space-evenly false
    (box :class "label" " ")
    (box :class "text" {value})))

(defwidget date_widget [value]
  (box :orientation "h"
       :class "date_widget text_container"
       :space-evenly false
    (box :class "label" "󰃭 ")
    (box :class "text" {value})))

(defwindow bar
  :monitor 0
  :windowtype "dock"
  :exclusive true
  :focusable false
  :stacking "fg"
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "10px"
                      :anchor "top center")
  (bar))
