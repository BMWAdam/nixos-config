#! /usr/bin/env nix-shell
#! nix-shell -i bash -p jq iio-sensor-proxy

ROT=$(hyprctl monitors -j | jq -r '.[] | select(.name == "eDP-1") | .transform')
echo "$ROT"

monitor-sensor | while read -r line; do
    # Filter out tilt spam, only look at orientation changes
    if [[ "$line" == *"Accelerometer orientation changed:"* ]]; then
        
        # Extract the orientation value (e.g., "normal", "right-up")
        ORIENTATION=$(echo "$line" | awk -F': ' '{print $2}')
        
        # Echo the corresponding Hyprland transform number to Eww
        if [[ "$ORIENTATION" == "normal" ]]; then
            echo "0"
        elif [[ "$ORIENTATION" == "right-up" ]]; then
            echo "1"
        elif [[ "$ORIENTATION" == "bottom-up" ]]; then
            echo "2"
        elif [[ "$ORIENTATION" == "left-up" ]]; then
            echo "3"
        fi
        
    fi
done
