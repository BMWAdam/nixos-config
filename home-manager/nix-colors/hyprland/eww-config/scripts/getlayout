#! /usr/bin/env nix-shell
#! nix-shell -i bash -p jq socat

last_layout=$(hyprctl devices -j | jq -r '.keyboards[] | select(.main == true) | .active_keymap | .[0:2]' | head -n 1)
echo "$last_layout"

socat -U - UNIX-CONNECT:"$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock" | while read -r line; do
    
    if [[ "$line" == "activelayout>>"* ]]; then
        
        full_layout="${line#*,}"
        short_layout="${full_layout:0:2}"
        
        if [[ "$short_layout" != "$last_layout" ]]; then
            echo "$short_layout"
            last_layout="$short_layout"
        fi
    fi
done
