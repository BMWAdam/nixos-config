#!/usr/bin/env nix-shell
#! nix-shell -i bash -p playerctl mpc python3

get_music() {
  local title
  title=$(playerctl metadata title 2>/dev/null)
  
  if [ -z "$title" ]; then
    title=$(mpc current 2>/dev/null)
  fi
  
  echo "$title"
}

stream_music() {
  get_music

  while true; do
    if command -v playerctl >/dev/null 2>&1; then
      playerctl metadata --format "{{title}}" --follow 2>/dev/null
    fi
    
    echo ""
    
    sleep 2
    get_music
  done
}

stream_music | python3 ~/.config/eww/music-widget/scroll.py 22 0.3
